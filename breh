-- Loads and executes a remote Lua script by URL
local function LoadAndRunScript(url)
	local ok, result = pcall(game.HttpGet, game, url)
	if ok and result then
		local chunk, err = loadstring(result)
		if chunk then
			chunk()
		else
			warn("Loadstring compile error: ", err)
		end
	else
		warn("HTTP Fetch failed for: ", url)
	end
end

