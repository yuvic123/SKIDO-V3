-- Returns true if any vault NPC (name matches "VAULT") is alive
local function IsVaultAlive()
	local Cashiers = workspace:FindFirstChild("Cashiers")
	if not Cashiers then return false end

	for _, npc in ipairs(Cashiers:GetChildren()) do
		if npc.Name:match("VAULT") then
			local hum = npc:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				return true
			end
		end
	end
	return false
end

