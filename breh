-- Filters a server list page to eligible servers (not visited, not full, within player count range)
local function FilterEligibleServers(serverPage, minPlayers, maxPlayers)
	local eligible = {}
	for _, server in ipairs(serverPage.data) do
		local valid = type(server) == "table"
		if valid then valid = type(server.id) == "string" end
		if valid then valid = type(server.playing) == "number" end
		if valid then valid = type(server.maxPlayers) == "number" end
		if valid then valid = server.id ~= game.JobId end
		if valid then valid = not visitedServers[server.id] end
		if valid then valid = server.playing < server.maxPlayers end
		if valid then valid = server.playing >= minPlayers and server.playing <= maxPlayers end

		if valid then
			table.insert(eligible, server.id)
		end
	end
	return eligible
end

