local isHopping = false

-- Initiates a server hop, trying to find and teleport to an eligible server
local function DoServerHop()
	local executor = (identifyexecutor or function() return "Unknown" end)()
	local useSolara = executor:match("Solara") or (executor:match("Xeno") or not queue_on_teleport)
	local targetServerId = FindEligibleServer(useSolara and "Asc" or "Desc")

	if not targetServerId then
		warn("No unvisited eligible server found (fallback: 3-6 players); retrying in 10 seconds.")
		return
	end

	if useSolara then
		TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, LocalPlayer)
		return
	end

	queue_on_teleport(" if not game:IsLoaded() then game.Loaded:Wait() end ")
	TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, LocalPlayer)
end

-- Finds an eligible server ID, paginating through server list as needed
FindEligibleServer = function(sortOrder)
	local firstPage = FetchServerPage(sortOrder)
	local nextCursor, seen = nil, {}

	if firstPage then
		local candidates = FilterEligibleServers(firstPage, 2, 35)
		if #candidates > 0 then
			return candidates[math.random(1, #candidates)]
		end
	else
		return nil
	end

	-- Fallback: paginate ascending looking for 3-6 player servers
	while true do
		local page = FetchServerPage("Asc", nextCursor)
		if not page then break end

		local candidates = FilterEligibleServers(page, 3, 6)
		if #candidates > 0 then
			return candidates[math.random(1, #candidates)]
		end

		-- Stop if the last server already exceeds the max player count
		local lastServer = page.data[#page.data]
		if lastServer and type(lastServer.playing) == "number" and lastServer.playing > 6 then
			return nil
		end

		nextCursor = page.nextPageCursor
		if type(nextCursor) ~= "string" or nextCursor == "" or seen[nextCursor] then
			return nil
		end

		seen[nextCursor] = true
		task.wait(0.25)
	end

	return nil
end

-- Starts the server hop loop (only runs once)
local function StartHopLoop()
	if isHopping then return end
	isHopping = true
	task.wait(1)
	while true do
		local ok, err = pcall(DoServerHop)
		if not ok then
			warn("Server hop failed: " .. tostring(err))
		end
		task.wait(10)
	end
end

