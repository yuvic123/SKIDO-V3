-- Returns nearby MoneyDrop parts within range of the player
-- FIX: increased range from 45 to 90 studs so farther drops aren't missed
local function GetNearbyMoneyDrops()
	local drops = {}
	local dropFolder = workspace:FindFirstChild("Ignored")
	if dropFolder then
		dropFolder = dropFolder:FindFirstChild("Drop")
	end
	if not dropFolder then return drops end

	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	for _, child in ipairs(dropFolder:GetChildren()) do
		if child.Name == "MoneyDrop" and hrp and child:IsA("BasePart") then
			if (child.Position - hrp.Position).Magnitude <= 90 then -- FIX: was 45
				table.insert(drops, child)
			end
		end
	end
	return drops
end

-- Cache for player headshot thumbnail URL
local cachedAvatarUrl = nil

-- Returns the player's headshot thumbnail URL
local function GetAvatarUrl()
	if cachedAvatarUrl then return cachedAvatarUrl end

	local ok, result = pcall(function()
		local url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. LocalPlayer.UserId .. "&size=150x150&format=Png&isCircular=false"
		local data = HttpService:JSONDecode(game:HttpGet(url))
		if data.data and data.data[1] then
			return data.data[1].imageUrl
		end
	end)

	if ok and type(result) == "string" and result:match("^https://") then
		cachedAvatarUrl = result
	else
		cachedAvatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png"
	end

	return cachedAvatarUrl
end

-- Sends a webhook notification with earnings info
local function SendWebhook(reason, earned)
	local webhook = getgenv().webhook
	if not webhook or webhook == "" or not request_ then return end

	local totalMoney = GetPlayerMoney()
	local fields = {
		{ name = "Total Money", value = "**$" .. tostring(totalMoney) .. "**", inline = true },
		{ name = "Earned This Server", value = "**$" .. tostring(earned) .. "**", inline = true }
	}

	if reason and reason:find("Instant Skip:", 1, true) then
		table.insert(fields, {
			name = "Server Hop",
			value = "No vaults — server hopping.",
			inline = false
		})
	end

	local payload = {
		embeds = {
			{
				thumbnail = { url = GetAvatarUrl() },
				fields = fields
			}
		}
	}

	pcall(function()
		request_({
			Url = webhook,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)
end

-- Buys a grenade from the shop by teleporting to the shop NPC and clicking
local function BuyGrenade()
	local Shop = workspace:FindFirstChild("Ignored")
	if Shop then Shop = Shop:FindFirstChild("Shop") end
	local grenadeShop = Shop and Shop:FindFirstChild("[Grenade] - $788")
	local clickDetector = grenadeShop and grenadeShop:FindFirstChild("ClickDetector")
	local hrp = clickDetector and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local originalCFrame = hrp.CFrame
	hrp.CFrame = grenadeShop.Head.CFrame * CFrame.new(0, 3, 0)
	task.wait(0.5)
	fireclickdetector_(grenadeShop.ClickDetector, 0)
	task.wait(0.3)
	hrp.CFrame = originalCFrame
end

-- Main vault run logic
local function RunVault()
	-- Wait for character
	while not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) do
		task.wait()
	end

	-- Skip if no vaults are alive on join
	if not IsVaultAlive() then
		SendWebhook("Instant Skip: All 4 vaults are empty on join.", 0)
		HopImmediately()
		return
	end

	local Character = LocalPlayer.Character
	local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
	local Humanoid = Character:WaitForChild("Humanoid")
	local moneyAtStart = GetPlayerMoney()

	-- Move to vault area
	HumanoidRootPart.CFrame = CFrame.new(vaultStandPosition)
	task.wait(1.2)

	-- Check if the outer vault door (VaultPart) exists
	local function GetVaultPart()
		local m = workspace:FindFirstChild("MAP")
		if m then m = m:FindFirstChild("Map") end
		if m then m = m:FindFirstChild("Vault") end
		if m then m = m:FindFirstChild("VaultPart") end
		return m
	end

	local vaultPart = GetVaultPart()
	local vaultIsOpen = not vaultPart -- if VaultPart is gone, vault is already open

	-- Shop items to purchase
	local shopItems = {
		{ Name = "[Grenade] - $788",             Count = vaultIsOpen and 0 or 3 },
		{ Name = "[Drum-Shotgun] - $1238",        Count = 1 },
		{ Name = "18 [Drum-Shotgun Ammo] - $73",  Count = 4 }
	}

	-- Buy items from the shop
	local Shop = workspace:FindFirstChild("Ignored")
	if Shop then Shop = Shop:FindFirstChild("Shop") end
	if Shop then
		for _, item in ipairs(shopItems) do
			if item.Count > 0 then
				local npc = Shop:FindFirstChild(item.Name)
				if npc then
					HumanoidRootPart.CFrame = npc.Head.CFrame * CFrame.new(0, 3, 0)
					task.wait(0.5)
					for _ = 1, item.Count do
						fireclickdetector_(npc.ClickDetector, 0)
						task.wait(0.25)
					end
				end
			end
		end
	end

	-- Locks camera to look at a target part; returns restore and update functions
	local function LockCameraAt(targetPart)
		local savedCameraMode = LocalPlayer.CameraMode
		local savedMinZoom = LocalPlayer.CameraMinZoomDistance
		local savedMaxZoom = LocalPlayer.CameraMaxZoomDistance
		local savedCameraType = CurrentCamera.CameraType
		local savedSubject = CurrentCamera.CameraSubject
		local targetPos = targetPart.Position
		local bindKey = "VaultGrenadeCamlock_" .. LocalPlayer.UserId
		local restored = false

		local function RestoreCamera()
			if restored then return end
			restored = true
			LocalPlayer.CameraMaxZoomDistance = savedMaxZoom
			LocalPlayer.CameraMinZoomDistance = savedMinZoom
			LocalPlayer.CameraMode = savedCameraMode
			CurrentCamera.CameraType = savedCameraType
			CurrentCamera.CameraSubject = savedSubject or Humanoid
		end

		local function UpdateCamera()
			if restored then return end
			if LocalPlayer.Character ~= Character or not HumanoidRootPart.Parent or Humanoid.Health <= 0 then
				RestoreCamera()
				return
			end

			if targetPart.Parent then
				targetPos = targetPart.Position
			end

			LocalPlayer.CameraMinZoomDistance = 0.5
			LocalPlayer.CameraMaxZoomDistance = 0.5
			LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
			CurrentCamera.CameraType = Enum.CameraType.Custom
			CurrentCamera.CameraSubject = Humanoid

			local camPos = CurrentCamera.CFrame.Position
			if (targetPos - camPos).Magnitude > 0.01 then
				CurrentCamera.CFrame = CFrame.new(camPos, targetPos)
				CurrentCamera.Focus = CFrame.new(targetPos)
			end
		end

		UpdateCamera()
		if restored then return RestoreCamera, UpdateCamera end
		RunService:BindToRenderStep(bindKey, Enum.RenderPriority.Camera.Value + 1, UpdateCamera)
		return RestoreCamera, UpdateCamera
	end

	-- Simulate a tap/click at screen center (mobile support)
	local function TapScreenCenter()
		local UIS = game:GetService("UserInputService")
		if not UIS.TouchEnabled or UIS.KeyboardEnabled or UIS.MouseEnabled then return end

		local ok, err = pcall(function()
			local VIM = game:GetService("VirtualInputManager")
			local center = CurrentCamera.ViewportSize / 2
			VIM:SendMouseMoveEvent(center.X, center.Y, game)
			for _ = 1, 2 do
				VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
				VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
			end
		end)

		if not ok then
			warn("Center-screen M1 unavailable; tap the vault manually. " .. tostring(err))
		end
	end

	-- Throws grenades to blow open the outer vault; returns true if vault opened, false on failure
	-- FIX: attempt limit raised from 4 to 8, added extra settle time after each explosion
	local function BlastOpenOuterVault()
		local attempts = 0
		while true do
			local currentVaultPart = GetVaultPart()

			-- Vault is open
			if not (currentVaultPart and currentVaultPart.Parent) then
				return true
			end
			if Humanoid.Health <= 0 or LocalPlayer.Character ~= Character then
				return false
			end
			if attempts >= 8 then -- FIX: was 4
				warn("Outer vault is still closed after 8 grenade attempts; server hopping.")
				HopImmediately()
				return false
			end

			attempts = attempts + 1

			-- Get or buy a grenade
			local grenade = LocalPlayer.Backpack:FindFirstChild("[Grenade]") or Character:FindFirstChild("[Grenade]")
			if not grenade then
				BuyGrenade()
				task.wait(0.4)
				grenade = LocalPlayer.Backpack:FindFirstChild("[Grenade]") or Character:FindFirstChild("[Grenade]")
			end
			if not grenade then
				warn("No grenade available to reopen the outer vault; stopping this run.")
				return false
			end

			-- Move and throw
			HumanoidRootPart.CFrame = CFrame.new(vaultStandPosition)
			task.wait(0.6)

			local aimPos = currentVaultPart.Position - Vector3.new(0, 10, 0)
			HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, Vector3.new(aimPos.X, HumanoidRootPart.Position.Y, aimPos.Z))

			local restoreCam, updateCam = LockCameraAt(currentVaultPart)
			TapScreenCenter()
			Humanoid:EquipTool(grenade)
			task.wait(0.5)
			updateCam()
			grenade:Activate()
			task.wait(0.7)
			if grenade.Parent == Character then
				updateCam()
				grenade:Activate()
			end
			task.wait(2.2)
			restoreCam()
			Humanoid:UnequipTools()
			task.wait(2)
			task.wait(1) -- FIX: extra settle time so VaultPart destruction can register
		end
	end

	-- Blast open the inner vault door if it's closed
	if not vaultIsOpen and vaultPart then
		local attempts = 0
		while true do
			local stillExists = vaultPart and vaultPart.Parent and attempts < 8 -- FIX: was 4
			if not stillExists then
				if attempts >= 8 then
					warn("Initial vault door still closed after 8 attempts; server hopping.")
					HopImmediately()
				end
				break
			end
			if Humanoid.Health <= 0 then return end

			attempts = attempts + 1

			local grenade = LocalPlayer.Backpack:FindFirstChild("[Grenade]") or Character:FindFirstChild("[Grenade]")
			if not grenade then
				BuyGrenade()
				task.wait(0.4)
				grenade = LocalPlayer.Backpack:FindFirstChild("[Grenade]") or Character:FindFirstChild("[Grenade]")
			end

			if grenade then
				HumanoidRootPart.CFrame = CFrame.new(vaultStandPosition)
				task.wait(0.6)

				local aimPos = vaultPart.Position - Vector3.new(0, 10, 0)
				HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, Vector3.new(aimPos.X, HumanoidRootPart.Position.Y, aimPos.Z))

				local restoreCam, updateCam = LockCameraAt(vaultPart)
				TapScreenCenter()
				Humanoid:EquipTool(grenade)
				task.wait(0.5)
				updateCam()
				grenade:Activate()
				task.wait(0.7)
				if grenade.Parent == Character then
					updateCam()
					grenade:Activate()
				end
				task.wait(2.2)
				restoreCam()
				Humanoid:UnequipTools()
			end

			task.wait(2)
			task.wait(1) -- FIX: extra settle time
		end

		CurrentCamera.CameraType = Enum.CameraType.Custom
		CurrentCamera.CameraSubject = Humanoid
	end

	-- Kill each vault NPC using the Drum-Shotgun
	local Cashiers = workspace:FindFirstChild("Cashiers")
	if Cashiers then
		for _, npc in ipairs(Cashiers:GetChildren()) do
			-- Ensure outer vault is open before engaging each NPC
			if not BlastOpenOuterVault() then return end

			local npcHumanoid = npc:FindFirstChildOfClass("Humanoid")
			local npcHead = npc:FindFirstChild("Head") or npc:FindFirstChild("Part")
			local isVaultNPC = npc.Name:match("VAULT") and npcHumanoid and npcHumanoid.Health > 0 and npcHead

			if isVaultNPC then
				local shotgun = LocalPlayer.Backpack:FindFirstChild("[Drum-Shotgun]") or Character:FindFirstChild("[Drum-Shotgun]")
				if shotgun then
					Humanoid:EquipTool(shotgun)
					task.wait(0.4)
					LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson

					local standCFrame = npcHead.CFrame * CFrame.new(0, 0, 3.5)
					HumanoidRootPart.CFrame = standCFrame
					task.wait(0.2)

					-- Keep shooting until NPC is dead
					while npcHumanoid.Health > 0 and npc.Parent do
						if Humanoid.Health <= 0 then
							LocalPlayer.CameraMode = Enum.CameraMode.Classic
							return
						end

						-- Re-blast vault if it closes mid-fight
						local innerVaultPart = GetVaultPart()
						if innerVaultPart and innerVaultPart.Parent then
							Humanoid:UnequipTools()
							if not BlastOpenOuterVault() then
								LocalPlayer.CameraMode = Enum.CameraMode.Classic
								return
							end
							if not npc.Parent or npcHumanoid.Health <= 0 then break end
							Humanoid:EquipTool(shotgun)
							task.wait(0.4)
							LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
							HumanoidRootPart.CFrame = standCFrame
							task.wait(0.2)
						end

						-- Face the NPC
						HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, Vector3.new(npcHead.Position.X, npcHead.Position.Y, npcHead.Position.Z))

						-- Reload if low on ammo
						local ammoValue = shotgun:FindFirstChild("Ammo")
						if ammoValue and ammoValue.Value <= 1 then
							local MainEvent = game:GetService("ReplicatedStorage"):FindFirstChild("MainEvent")
							if MainEvent then
								MainEvent:FireServer("Reload", shotgun)
							end
							task.wait(2)
							HumanoidRootPart.CFrame = standCFrame
						end

						shotgun:Activate()
						task.wait(0.12)
					end

					Humanoid:UnequipTools()
					LocalPlayer.CameraMode = Enum.CameraMode.Classic
					task.wait(0.2)
				end
			end
		end
	end

	-- Collect money drops
	Humanoid:UnequipTools()
	task.wait(0.5)

	local lockToCFrame = nil
	local lockConnection = RunService.PreSimulation:Connect(function()
		if lockToCFrame and HumanoidRootPart.Parent and LocalPlayer.Character == Character and Humanoid.Health > 0 then
			HumanoidRootPart.CFrame = lockToCFrame
		end
	end)

	local startTime = tick()
	while tick() - startTime < 25 do
		local drops = GetNearbyMoneyDrops()

		-- FIX: don't hop on first empty scan — wait and rescan once to avoid
		-- hopping early when drops spawn slightly outside the previous 45 stud range
		if #drops == 0 then
			task.wait(1.5)
			drops = GetNearbyMoneyDrops()
			if #drops == 0 then
				lockConnection:Disconnect()
				local earned = math.max(0, GetPlayerMoney() - moneyAtStart)
				SendWebhook("Successfully finished run and harvested money.", earned)
				task.wait(1)
				HopImmediately()
				return
			end
		end

		for _, drop in ipairs(drops) do
			local cd = drop:FindFirstChildOfClass("ClickDetector")
			if cd and HumanoidRootPart then
				lockToCFrame = drop.CFrame * CFrame.new(0, 3, 0)
				HumanoidRootPart.CFrame = lockToCFrame
				task.wait(0.4)
				fireclickdetector_(cd)
				task.wait(0.4)
			end
		end

		task.wait(0.5)
	end

	lockConnection:Disconnect()
	local earned = math.max(0, GetPlayerMoney() - moneyAtStart)
	SendWebhook("Successfully finished run and harvested money.", earned)
	task.wait(1)
	HopImmediately()
end

-- Entry point
if IsVaultAlive() then
	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1.5)
		RunVault()
	end)
	RunVault()
else
	SendWebhook("Instant Skip: Server empty at execution.", 0)
	HopImmediately()
end
