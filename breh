-- Fetches a page of public servers from the Roblox API
local function FetchServerPage(sortOrder, cursor)
	local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100"
	if cursor then
		url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
	end

	local ok, result = pcall(function()
		return HttpService:JSONDecode(unpack_({ game:HttpGet(url) }))
	end)

	if not ok then return nil end
	if type(result) ~= "table" then return nil end
	if type(result.data) ~= "table" then return nil end
	return result
end

