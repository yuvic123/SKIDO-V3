-- Returns the player's current money from leaderstats or DataFolder
local function GetPlayerMoney()
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats = leaderstats:FindFirstChild("Money")
	end
	if leaderstats then
		return leaderstats.Value
	end

	local DataFolder = LocalPlayer:FindFirstChild("DataFolder")
	if not DataFolder then
		return 0
	end
	DataFolder = DataFolder:FindFirstChild("Currency")
	return not DataFolder and 0 or DataFolder.Value
end

